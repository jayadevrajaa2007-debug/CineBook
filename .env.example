# CineBook Database Configuration
# Copy this file to .env and configure your MySQL credentials:
# cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=cinebook
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here

# Google Sheets Sync Configuration
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Tickets
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/google-service-account.json
# Alternative to credentials file:
# GOOGLE_SHEETS_CREDENTIALS_JSON=

